# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development

# Required in production: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# PostgreSQL 16 with the pgvector extension.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/assistant_platform
DB_CONN_MAX_AGE=60

# Redis (cache + Celery broker/result backend).
REDIS_URL=redis://localhost:56379/0
CELERY_BROKER_URL=redis://localhost:56379/1
CELERY_RESULT_BACKEND=redis://localhost:56379/2

# Browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- AI providers ----------------------------------------------------------
# Which provider answers chat requests: mock (deterministic, no network) | openai.
# The platform is BYO-key: these are the *platform* defaults, and a client can store
# their own key per workspace in Settings -> AI provider (that key wins for them).
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL_NAME=mock-model-1
# Human name shown in the console for the configured provider, e.g. the gateway
# vendor. Empty falls back to "OpenAI-compatible".
AI_PROVIDER_LABEL=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint: a gateway (LiteLLM, OpenRouter, Azure OpenAI),
# vLLM or Ollama (/v1). Leave empty to use https://api.openai.com/v1.
# Example: https://api.experientiallabs.ai/v1
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
# After changing any of the above:
#   docker compose up -d --no-deps --force-recreate api
#   docker compose exec api python manage.py ai_check --call
# Encrypts provider keys saved from the console (Settings -> AI provider).
# Falls back to DJANGO_SECRET_KEY when empty; set it so rotating one does not
# invalidate the other. Changing it makes stored workspace keys unreadable.
AI_CREDENTIALS_KEY=

# Embeddings / vector search
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Requires the pgvector extension; enable only after re-running migrations if
# EMBEDDING_DIMENSIONS changes (the column dimension is fixed at migration time).
VECTOR_SEARCH_ENABLED=False

# --- Policy engine ---------------------------------------------------------
POLICY_MODEL_EVALUATOR_ENABLED=False
# closed = refuse when a mandatory check cannot complete; open = degrade to rules
POLICY_FAIL_MODE=closed
POLICY_CLASSIFIER_MODEL=gpt-4o-mini
POLICY_DEFAULT_ALLOW_THRESHOLD=0.60
POLICY_DEFAULT_CLARIFY_THRESHOLD=0.34

# --- Limits ----------------------------------------------------------------
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_MAX_OUTPUT_TOKENS=800
CHAT_REQUEST_TIMEOUT=45
CHAT_IDEMPOTENCY_TTL_HOURS=24
RATE_LIMIT_CHAT_PER_MINUTE=120
KNOWLEDGE_MAX_FILE_BYTES=10485760
CONVERSATION_RETENTION_DAYS=365

# --- Email -----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_FROM=no-reply@assistant-platform.local

# --- Operations ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
EXPOSE_API_DOCS=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Messaging channels (Telegram) -----------------------------------------
# Off until an operator turns it on; the webhook and the console both 404 while off.
CHANNELS_ENABLED=false
# Public HTTPS origin Telegram delivers updates to. Must be reachable from the internet.
CHANNELS_PUBLIC_BASE_URL=
CHANNELS_TELEGRAM_MAX_PARTS=3
CHANNELS_TELEGRAM_ALLOW_FORWARDS=false
CHANNELS_MAX_UPDATE_AGE_SECONDS=3600
CHANNELS_EVENT_RETENTION_DAYS=30
CHANNELS_IDENTITY_RETENTION_DAYS=180
# Bot tokens are encrypted with AI_CREDENTIALS_KEY (falls back to SECRET_KEY).
